#@ ---------------------------------------------------------------------------
#@ Mu2e DAQ -- main ssh client configuration template
#@
#@ Lines beginning with "#@" are directives for mu2e-ssh-setup and are stripped
#@ from the generated output.  Tokens of the form @@NAME@@ are substituted.
#@ ---------------------------------------------------------------------------
# ===========================================================================
#  ~/.ssh/config -- Mu2e DAQ standard client configuration
#
#  Generated by mu2e-ssh-setup @@GENERATOR_VERSION@@ on @@GENERATED_ON@@
#  Target platform : @@PLATFORM@@
#  Layout          : @@LAYOUT@@
#
#  DO NOT EDIT THIS FILE BY HAND.  Re-run mu2e-ssh-setup to regenerate it, or
#  put your own private host entries in @@SSH_DIR@@/config_other, which is
#  never overwritten by the generator.
#
#  Documentation: Bootstrap/ssh/SSH-HOWTO.md
# ===========================================================================

###########################
# Keywords that only some ssh builds know about.  This MUST come before any
# Host block -- and before the Include lines -- because ssh aborts the whole
# parse on an unrecognised keyword no matter which host you are connecting to,
# and an IgnoreUnknown inside a Host block only covers hosts that match it.
#
#   UseKeychain               macOS only.
#   GSSAPIRenewalForcesRekey  Present in the RHEL/Debian OpenSSH builds, which
#                             carry the GSSAPI key-exchange patch; absent from
#                             Apple's ssh. Used by the gpvm blocks.
#
# Listing a keyword here costs nothing where it IS supported: it is still
# applied normally.
IgnoreUnknown UseKeychain,GSSAPIRenewalForcesRekey

#@if canonicalize
###########################
# Treat bare hostnames (e.g. "mu2edaq09") as being in the fnal.gov domain, so
# that the Host patterns below match whether or not you type the domain.
CanonicalizeHostname yes
CanonicalDomains @@CANONICAL_DOMAIN@@
CanonicalizeMaxDots 0
CanonicalizeFallbackLocal yes

#@endif
###########################
# Major host groups.
#
# These MUST come before the "Host *" and Fermilab public-network blocks
# further down.  ssh uses the FIRST value it finds for any given keyword, so a
# host-specific setting only wins if ssh sees it before the generic default
# claims that same keyword.
#@include-block

###########################
# General defaults for all hosts
Host *
#@if keychain
        # macOS-only; covered by the IgnoreUnknown at the top of this file, so
        # it is harmless if you copy this config to Linux or Windows.
        UseKeychain             yes
#@endif
        AddKeysToAgent          yes
        IdentityFile            @@KEY_DEFAULT@@
#@if agent
        ForwardAgent            yes
#@endif
#@if x11
        ForwardX11              yes
        ForwardX11Trusted       yes
#@else
        ForwardX11              no
#@endif
        Compression             yes
        CheckHostIP             yes
        ServerAliveInterval     60
        ServerAliveCountMax     5
        StrictHostKeyChecking   @@STRICT_HOST_KEY_CHECKING@@
#@if controlmaster
        ControlMaster           auto
        ControlPath             @@SSH_DIR@@/connections/%r_%h_%p
        ControlPersist          10m
#@endif

###########################
# Fermilab public-network hosts
Host 131.225.*.* *.fnal.gov
#@if gssapi
        GSSAPIAuthentication    yes
        GSSAPIDelegateCredentials yes
#@endif
#@if x11
        ForwardX11              yes
        ForwardX11Trusted       yes
#@endif
        Compression             yes
        CheckHostIP             yes
